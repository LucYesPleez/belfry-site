---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms.js';
---

<section class="rooms">
  <div class="wrap head-wrap">
    <p class="eyebrow">Stay your way</p>
    <div class="eyebrow-rule"></div>

    <div class="head">
      <h2 class="display heading">Our Rooms</h2>

      <div class="tools">
        <div class="arrows" data-arrows hidden>
          <button type="button" class="arrow" data-scroll="-1" aria-label="Previous rooms">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M18 5H2M6 1L2 5l4 4" />
            </svg>
          </button>
          <button type="button" class="arrow" data-scroll="1" aria-label="More rooms">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M0 5h16M12 1l4 4-4 4" />
            </svg>
          </button>
        </div>

        <a class="all" href="/stay">
          All rooms
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
            <path d="M0 5h16M12 1l4 4-4 4" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <ul class="rail" data-rail tabindex="0" role="region" aria-label="Rooms, scrollable">
    {
      rooms.map((room) => (
        <li class="card">
          <a href={`/stay/${room.slug}`}>
            <Image
              class="shot"
              src={room.image}
              alt={room.alt}
              widths={[240, 480]}
              sizes="240px"
              quality={80}
            />
            <div class="body">
              <h3 class="display name">{room.name}</h3>
              <p class="type">{room.type}</p>
              <p class="amenities">{room.features.join(' · ')}</p>
              <p class="rate">From ${room.fromRate} / night</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const rail = document.querySelector('[data-rail]');
  const arrows = document.querySelector('[data-arrows]');

  if (rail && arrows) {
    const step = () => {
      const card = rail.querySelector('.card');
      return card ? card.getBoundingClientRect().width + 16 : 240;
    };

    // Arrows only earn their place when there is something to scroll to, and
    // a rail that cannot scroll should sit centred rather than leaving a hole.
    const sync = () => {
      const still = rail.scrollWidth <= rail.clientWidth + 4;
      arrows.hidden = still;
      rail.classList.toggle("is-static", still);
      for (const b of arrows.querySelectorAll('button')) {
        const dir = Number(b.dataset.scroll);
        const atStart = rail.scrollLeft < 4;
        const atEnd = rail.scrollLeft > rail.scrollWidth - rail.clientWidth - 4;
        b.disabled = dir < 0 ? atStart : atEnd;
      }
    };

    arrows.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      rail.scrollBy({ left: Number(b.dataset.scroll) * step(), behavior: 'smooth' });
    });

    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  .rooms {
    padding-bottom: clamp(3rem, 7vw, 6.25rem);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.375rem;
  }

  .heading {
    font-size: clamp(2rem, 3.9vw, 3rem);
    line-height: 1.1;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .arrows {
    display: flex;
    gap: 0.5rem;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--hairline);
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .arrow:hover:not(:disabled) {
    border-color: var(--olive);
    color: var(--olive);
  }

  .arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .all {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }

  /* A scroll-snap rail rather than a grid: no library, works with touch,
     trackpad and the arrows, and degrades to a plain scroller. */
  .rail {
    list-style: none;
    margin: 1.875rem 0 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(11.25rem, 20vw, 13.75rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* bleeds to the window edges so cards can run off-screen */
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    /* without this the snap points ignore the padding and the first card
       parks flush against the screen edge, breaking the page gutter */
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  /* nothing to scroll to: centre the cards instead of leaving a gap */
  .rail.is-static {
    justify-content: center;
  }

  .card {
    scroll-snap-align: start;
    background: var(--card);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card a:hover .shot {
    transform: scale(1.03);
  }

  .body {
    padding: 0.875rem 1rem 1.125rem;
    flex-grow: 1;
  }

  .name {
    font-size: 1.375rem;
  }

  .type {
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.375rem;
  }

  .amenities {
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--body);
    margin-top: 0.5rem;
  }

  .rate {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #3f3b35;
    margin-top: 0.75rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 60rem) {
    .arrows {
      display: none;
    }
    .rail {
      grid-auto-columns: 60vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card a:hover .shot {
      transform: none;
    }
  }
</style>
