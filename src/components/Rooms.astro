---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms.js';
---

<section class="rooms wrap">
  <p class="eyebrow">Stay your way</p>
  <div class="eyebrow-rule"></div>

  <div class="head">
    <h2 class="display heading">Our Rooms</h2>
    <a class="all" href="/stay">
      All rooms
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
        <path d="M0 5h16M12 1l4 4-4 4" />
      </svg>
    </a>
  </div>

  <ul class="grid">
    {
      rooms.map((room) => (
        <li class="card">
          <a href={`/stay/${room.slug}`}>
            <Image
              class="shot"
              src={room.image}
              alt={room.alt}
              widths={[300, 440, 880]}
              sizes="(max-width: 45rem) 100vw, (max-width: 70rem) 45vw, 22vw"
              quality={80}
            />
            <div class="body">
              <h3 class="display name">{room.name}</h3>
              <p class="type">{room.type}</p>
              <p class="amenities">{room.features.join(' · ')}</p>
            </div>
            <p class="rate">From ${room.fromRate} / night</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .rooms {
    padding-bottom: clamp(3rem, 7vw, 6.25rem);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.375rem;
  }

  .heading {
    font-size: clamp(2rem, 3.9vw, 3rem);
    line-height: 1.1;
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3125rem;
    white-space: nowrap;
  }

  .grid {
    list-style: none;
    margin: 1.875rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--hairline);
  }

  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  /* Astro's <Image> emits width/height attributes; without height:auto the
     intrinsic height wins and aspect-ratio never applies. */
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 7;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card a:hover .shot {
    transform: scale(1.03);
  }

  /* the image is the only thing that should move on hover */
  .card {
    overflow: hidden;
  }

  .body {
    padding: 1.25rem 1.375rem 0;
    flex-grow: 1;
  }

  .name {
    font-size: 1.75rem;
  }

  .type {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .amenities {
    font-size: 0.75rem;
    color: var(--body);
    margin-top: 0.75rem;
  }

  .rate {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #3f3b35;
    margin: 1.125rem 1.375rem 0;
    padding-block: 0.9375rem 1.125rem;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 70rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
