---
import { bookingUrl } from '../data/site.js';

const links = [
  { label: 'Stay', href: '/stay' },
  { label: 'Experience', href: '/experience' },
  { label: 'Bellingen', href: '/bellingen' },
  { label: 'Our Story', href: '/our-story' },
];
---

<header class="header" data-header>
  <div class="frost"></div>
  <div class="bar">
    <a class="mark" href="/">
      <span class="mark-name">The Belfry</span>
      <span class="mark-sub">Guesthouse</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="actions">
      <a class="btn btn-solid book" href={bookingUrl}>Book your stay</a>
      <button
        class="menu"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="panel" id="mobile-menu" hidden data-menu-panel>
    <nav aria-label="Primary, mobile">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-solid panel-book" href={bookingUrl}>Book your stay</a>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = header?.querySelector('[data-menu-toggle]');
  const panel = header?.querySelector('[data-menu-panel]');

  const setOpen = (open) => {
    if (!header || !toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
    header.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // The panel only exists at narrow widths; don't leave it open on resize.
  window.matchMedia('(min-width: 60rem)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  /* Translucent bar that dissolves into the photo rather than ending on a line. */
  .frost {
    position: absolute;
    inset: 0 0 auto;
    height: 6.75rem;
    background: linear-gradient(
      180deg,
      rgba(26, 21, 15, 0.46) 0%,
      rgba(26, 21, 15, 0.4) 52%,
      rgba(26, 21, 15, 0) 100%
    );
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 50%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 50%, transparent 100%);
    pointer-events: none;
  }

  .bar {
    position: relative;
    max-width: var(--max);
    margin-inline: auto;
    padding: 1.125rem var(--gutter) 0;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .mark {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: #fbf9f4;
  }

  .mark:hover {
    color: #fbf9f4;
  }

  .mark-name {
    font-family: var(--display);
    font-size: 1.75rem;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
  }

  .mark-sub {
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    color: #d9d2c4;
    text-align: center;
    text-transform: uppercase;
  }

  .nav {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .nav a {
    color: #f1ede4;
    font-weight: 500;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav a:hover {
    color: #fff;
    border-bottom-color: rgba(241, 237, 228, 0.7);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.625rem;
  }

  .book {
    padding: 0.875rem 1.625rem;
  }

  .menu {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 0;
    /* a 44px target without moving the bars visually */
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    margin-right: -0.5rem;
    cursor: pointer;
  }

  .menu span {
    display: block;
    width: 1.625rem;
    height: 1.5px;
    background: #f1ede4;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .header.is-open .menu span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .header.is-open .menu span:nth-child(2) {
    opacity: 0;
  }

  .header.is-open .menu span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .panel {
    position: relative;
    margin: 0.75rem var(--gutter) 0;
    padding: 0.5rem 0 1.25rem;
    background: rgba(26, 21, 15, 0.9);
    backdrop-filter: blur(10px);
  }

  .panel nav {
    display: flex;
    flex-direction: column;
  }

  .panel nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    color: #f1ede4;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .panel nav a:hover {
    color: #fff;
    background: rgba(241, 237, 228, 0.08);
  }

  .panel-book {
    display: block;
    margin: 0.75rem 1.25rem 0;
    text-align: center;
  }

  @media (max-width: 60rem) {
    .nav {
      display: none;
    }
    /* Booking moves into the bar itself. The wordmark gives up some size to
       make room for it beside the menu. */
    .mark-name {
      font-size: 1.375rem;
      /* never let the wordmark break across two lines */
      white-space: nowrap;
    }
    /* keep the subline in the same proportion to the wordmark as desktop
       (9/28); it does not shrink with it otherwise */
    .mark-sub {
      font-size: 0.4375rem;
    }
    .book {
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
      padding: 0.6875rem 0.6875rem;
      white-space: nowrap;
    }
    .actions {
      gap: 0.5rem;
    }
    .menu {
      display: flex;
    }
    .bar {
      justify-content: space-between;
      gap: 1rem;
      padding-top: 0.875rem;
    }
  }
</style>
