---
import { Image } from 'astro:assets';
import nswHallOfFame from '../assets/awards/nsw-hall-of-fame.png';
import northCoast2024 from '../assets/awards/north-coast-2024.png';
import nsw2025 from '../assets/awards/nsw-2025.png';
import nsw2026 from '../assets/awards/nsw-2026.png';
import australian2025 from '../assets/awards/australian-2025.png';
import qualityTourism from '../assets/awards/quality-tourism.png';
import sustainableTourism from '../assets/awards/sustainable-tourism.png';

// Marks are cut from the supplied layout, so they are low-resolution. Replace
// with vector or full-size originals from the awarding bodies before launch.
const hallOfFame = {
  logo: nswHallOfFame,
  alt: 'NSW Regional Tourism Awards',
  body: 'NSW Regional Tourism Awards',
  year: '2026',
  result: 'Hall of Fame',
};

// The three golds take the first row; the commendation and the two standing
// accreditations follow on the second.
const rest = [
  { logo: northCoast2024, alt: 'North Coast Tourism Awards', body: 'North Coast Tourism Awards', year: '2024', result: 'Gold' },
  { logo: nsw2025, alt: 'NSW Regional Tourism Awards', body: 'NSW Regional Tourism Awards', year: '2025', result: 'Gold' },
  { logo: nsw2026, alt: 'NSW Regional Tourism Awards', body: 'NSW Regional Tourism Awards', year: '2026', result: 'Gold' },
  { logo: australian2025, alt: 'Australian Tourism Awards', body: 'Australian Tourism Awards', year: '2025', result: 'Highly Commended', highlight: true },
  { logo: qualityTourism, alt: 'Quality Tourism accredited business', body: 'Quality Tourism', result: 'Accredited Business' },
  { logo: sustainableTourism, alt: 'Sustainable Tourism accredited business', body: 'Sustainable Tourism', result: 'Accredited Business' },
];
---

<section class="awards">
  <div class="wrap">
    <div class="title">
      <span class="rule"></span>
      <h2>Recognised with care</h2>
      <span class="rule"></span>
    </div>

    <div class="feature">
      <Image class="mark wide" src={hallOfFame.logo} alt={hallOfFame.alt} widths={[96, 192]} sizes="96px" />
      <div class="text">
        <p class="body-name">{hallOfFame.body}</p>
        <p class="year">{hallOfFame.year}</p>
        <p class="result crown">{hallOfFame.result}</p>
      </div>
    </div>

    <ul class="grid">
      {
        rest.map((a) => (
          <li>
            <Image class="mark" src={a.logo} alt={a.alt} widths={[56, 112]} sizes="56px" />
            <div class="text">
              <p class="body-name">{a.body}</p>
              {a.year && <p class="year">{a.year}</p>}
              <p class:list={['result', { highlight: a.highlight }]}>{a.result}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="thanks display">
      Thank you to our guests and community for being part of our story.
    </p>
  </div>
</section>

<style>
  /* Sits directly above the booking CTA, so it carries its own top space. */
  .awards {
    background: var(--cream-deep);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .title h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(0.9375rem, 1.5vw, 1.1875rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* Hall of Fame is the headline result, so it stands alone above the rest. */
  .feature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--hairline);
    text-align: left;
  }

  .feature .mark {
    width: clamp(4rem, 6vw, 5.25rem);
  }

  .feature .body-name,
  .feature .year,
  .feature .result {
    font-size: 0.8125rem;
  }

  .crown {
    color: var(--ink);
  }

  .grid {
    list-style: none;
    margin: clamp(1.5rem, 2.5vw, 2rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem) 0;
  }

  .grid li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.625rem, 1.2vw, 1rem);
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-left: 1px solid var(--hairline);
  }

  .grid li:nth-child(3n + 1) {
    border-left: 0;
  }

  .mark {
    flex: none;
    width: 2.75rem;
    height: auto;
  }

  .body-name {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--ink);
  }

  .year {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--body);
    margin-top: 0.4375rem;
  }

  .result {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--body);
    margin-top: 0.125rem;
  }

  .result.highlight {
    color: #9a7b2e;
  }

  .thanks {
    font-style: italic;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    text-align: center;
    color: var(--body);
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid li:nth-child(3n + 1) {
      border-left: 1px solid var(--hairline);
    }
    .grid li:nth-child(odd) {
      border-left: 0;
    }
  }

  /* Two across on a phone as well — three rows of two. The mark moves above
     the text, since side by side leaves the labels about 100px to wrap in. */
  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 0;
    }
    .grid li {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
      padding-inline: 0.75rem;
    }
    .grid li:nth-child(odd) {
      border-left: 0;
    }
  }
</style>
