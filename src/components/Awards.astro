---
import { Image } from 'astro:assets';
import nswHallOfFame from '../assets/awards/nsw-hall-of-fame.png';
import northCoast2024 from '../assets/awards/north-coast-2024.png';
import nsw2025 from '../assets/awards/nsw-2025.png';
import nsw2026 from '../assets/awards/nsw-2026.png';
import australian2025 from '../assets/awards/australian-2025.png';
import qualityTourism from '../assets/awards/quality-tourism.png';
import sustainableTourism from '../assets/awards/sustainable-tourism.png';

// Marks are cut from the supplied layout, so they are low-resolution. Replace
// with vector or full-size originals from the awarding bodies before launch.
const awards = [
  { logo: nswHallOfFame, alt: 'NSW Regional Tourism Awards', body: 'NSW Regional Tourism Awards', year: '2026', result: 'Hall of Fame', wide: true },
  { logo: northCoast2024, alt: 'North Coast Tourism Awards', body: 'North Coast Tourism Awards', year: '2024', result: 'Gold' },
  { logo: nsw2025, alt: 'NSW Regional Tourism Awards', body: 'NSW Regional Tourism Awards', year: '2025', result: 'Gold' },
  { logo: nsw2026, alt: 'NSW Regional Tourism Awards', body: 'NSW Regional Tourism Awards', year: '2026', result: 'Gold' },
  { logo: australian2025, alt: 'Australian Tourism Awards', body: 'Australian Tourism Awards', year: '2025', result: 'Highly Commended', highlight: true },
  { logo: qualityTourism, alt: 'Quality Tourism accredited business', body: 'Quality Tourism', result: 'Accredited Business' },
  { logo: sustainableTourism, alt: 'Sustainable Tourism accredited business', body: 'Sustainable Tourism', result: 'Accredited Business' },
];
---

<section class="awards">
  <div class="wrap">
    <div class="title">
      <span class="rule"></span>
      <h2>Recognised with care</h2>
      <span class="rule"></span>
    </div>

    <ul class="row">
      {
        awards.map((a) => (
          <li>
            <Image class:list={['mark', { wide: a.wide }]} src={a.logo} alt={a.alt} widths={[56, 112]} sizes="56px" />
            <div class="text">
              <p class="body-name">{a.body}</p>
              {a.year && <p class="year">{a.year}</p>}
              <p class:list={['result', { highlight: a.highlight }]}>{a.result}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="thanks display">
      Thank you to our guests and community for being part of our story.
    </p>
  </div>
</section>

<style>
  /* Sits directly under the hero, so it carries its own top space. */
  .awards {
    background: var(--cream-deep);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .title h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(0.9375rem, 1.5vw, 1.1875rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* The seven always read as one unbroken band — they never wrap. Below the
     width where that still fits, the row scrolls sideways instead. */
  .row {
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0;
  }

  .row li {
    display: flex;
    align-items: center;
    gap: clamp(0.375rem, 0.8vw, 0.75rem);
    padding-inline: clamp(0.4375rem, 1vw, 0.9375rem);
    border-left: 1px solid var(--hairline);
  }

  .row li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .mark {
    flex: none;
    width: 2.5rem;
    height: auto;
  }

  .mark.wide {
    width: 3.5rem;
  }

  .body-name {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--ink);
  }

  .year {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--body);
    margin-top: 0.4375rem;
  }

  .result {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--body);
    margin-top: 0.125rem;
  }

  .result.highlight {
    color: #9a7b2e;
  }

  .thanks {
    font-style: italic;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    text-align: center;
    color: var(--body);
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  /* Narrower than the band can honestly hold: keep the single line and let it
     scroll, rather than breaking it into rows. */
  @media (max-width: 64rem) {
    .row {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(10rem, 1fr);
      overflow-x: auto;
      scrollbar-width: none;
      /* bleed to the screen edges so the scroll reads as more to come */
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .row::-webkit-scrollbar {
      display: none;
    }
  }
</style>
