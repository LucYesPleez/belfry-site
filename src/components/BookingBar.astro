---
import { bookingUrl } from '../data/site.js';

// Phones only. The header's Book your stay is hidden behind the menu at this
// width, so the action needs to sit in the page itself, directly under the
// hero rather than inside it where it crowded the photograph.
---

<div class="book-strip">
  <a class="btn btn-solid" href={bookingUrl}>Book your stay</a>
</div>

<style>
  .book-strip {
    display: none;
    background: var(--cream);
    padding: 1.5rem var(--gutter) 0;
  }

  .book-strip .btn {
    display: block;
    text-align: center;
    padding-block: 1.0625rem;
  }

  @media (max-width: 60rem) {
    .book-strip {
      display: block;
    }
  }
</style>
