---
// Contact details taken from the latest layout. They disagree with the earlier
// "Plan your stay" mockup (19 Short Street / 02 6655 1145 /
// stay@thebelfrybellingen.com.au) — confirm which set is current.
const contact = {
  street: '62 Hyde Street, Bellingen',
  region: 'NSW 2454 Australia',
  phone: '+61 2 6655 1262',
  phoneHref: 'tel:+61266551262',
  email: 'stay@thebelfry.com.au',
};

const navigate = [
  { label: 'Stay', href: '/stay' },
  { label: 'Rooms', href: '/stay' },
  { label: 'Experience', href: '/experience' },
  { label: 'About', href: '/our-story' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="footer">
  <div class="wrap inner">
    <div class="col brand">
      <p class="mark">
        <span class="mark-name">The Belfry</span>
        <span class="mark-sub">Guesthouse &amp; Retreat</span>
      </p>
      <address>
        {contact.street}<br />
        {contact.region}
      </address>
      <p class="line"><span class="key">T.</span> <a href={contact.phoneHref}>{contact.phone}</a></p>
      <p class="line"><span class="key">E.</span> <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>

    <nav class="col" aria-label="Footer">
      <h2 class="col-head">Navigate</h2>
      <ul>
        {navigate.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="col">
      <h2 class="col-head">Follow us</h2>
      <ul class="social">
        <li>
          <a href="https://www.instagram.com/" aria-label="The Belfry on Instagram">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/" aria-label="The Belfry on Facebook">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-1.6 19.9v-7h-2.5V12h2.5V9.8c0-2.5 1.5-3.8 3.7-3.8 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="col closing">
      <svg class="sprig" width="26" height="26" viewBox="0 0 34 34" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true">
        <path d="M17 30V12" />
        <path d="M17 18c0-4 3-7 8-7 0 4-3 7-8 7z" />
        <path d="M17 24c0-4-3-7-8-7 0 4 3 7 8 7z" />
        <path d="M17 12c0-3 2-6 5-7 0 3-2 6-5 7z" />
      </svg>
      <p class="motto display">A place to rest,<br />in the heart of Bellingen.</p>
      <p class="fine">&copy; The Belfry 2026</p>
      <p class="fine"><a href="/privacy">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #3f4433;
    color: #ddd8c8;
    font-size: 0.8125rem;
    line-height: 1.75;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .col-head {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f1efe4;
    margin-bottom: 1rem;
  }

  .mark-name {
    display: block;
    font-family: var(--display);
    font-size: 1.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f1efe4;
  }

  .mark-sub {
    display: block;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #b3ad99;
    margin-top: 0.375rem;
  }

  address {
    font-style: normal;
    margin-top: 1.5rem;
  }

  .line {
    margin-top: 0.5rem;
  }

  .key {
    color: #b3ad99;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer a {
    color: #ddd8c8;
  }

  .footer a:hover {
    color: #fff;
  }

  .social {
    display: flex;
    gap: 0.875rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(241, 239, 228, 0.12);
  }

  .social a:hover {
    background: rgba(241, 239, 228, 0.24);
  }

  .closing {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .sprig {
    color: #b3ad99;
  }

  .motto {
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: #e8e4d6;
    margin-top: 0.75rem;
  }

  .fine {
    color: #b3ad99;
    margin-top: 0.5rem;
  }

  @media (max-width: 60rem) {
    .inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .closing {
      text-align: left;
      align-items: flex-start;
    }
  }

  @media (max-width: 34rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
